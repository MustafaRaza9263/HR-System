NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/hr-system

# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=hr-system-api
JWT_AUDIENCE=hr-system-frontend
SESSION_TTL_DAYS=30

# Public origin of the Next.js app. Used to build department access-link URLs.
FRONTEND_URL=http://localhost:3000

# Comma-separated browser origins allowed to send credentialed API requests.
CORS_ORIGINS=http://localhost:3000

# Leave blank for localhost. In production, use a shared parent domain when the
# frontend and API run on subdomains (for example: .example.com).
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
TRUST_PROXY=0

# Optional. When set, HR browser-push (FCM) is enabled. Leave blank to skip push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
