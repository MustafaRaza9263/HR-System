# Public URL used by browser requests.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional private URL used by Next.js server rendering. Defaults to the public URL.
API_INTERNAL_URL=http://localhost:4000/api/v1
PORT=3000

# Optional Firebase web config for HR browser-push. Leave blank to skip.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
